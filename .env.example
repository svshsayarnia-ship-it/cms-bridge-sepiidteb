# Public WordPress store URL. Do not add /wp-admin or /wp-json.
WORDPRESS_URL=https://sepiidbeauty.ir

# Create a fresh WooCommerce REST API key with Read/Write access.
# Keep both values in the deployment environment, never in source control.
WOOCOMMERCE_CONSUMER_KEY=ck_replace_with_fresh_key
WOOCOMMERCE_CONSUMER_SECRET=cs_replace_with_fresh_secret

# Public canonical URL for the main storefront.
NEXT_PUBLIC_SITE_URL=https://sepiidbeauty.ir

# Independent CMS login for cms.sepiidbeauty.ir.
CMS_ADMIN_USER=admin@sepiidbeauty.ir
CMS_ADMIN_NAME=Sepiid Admin
CMS_ADMIN_PASSWORD=replace_with_a_strong_panel_password
CMS_SESSION_SECRET=replace_with_a_long_random_session_secret

# Use query only if the host strips the HTTP Authorization header.
WOOCOMMERCE_AUTH_MODE=basic

# Local development only. Used only when CMS_ADMIN_PASSWORD is not configured.
CMS_ALLOWED_EMAILS=owner@example.com
CMS_DEV_EMAIL=owner@example.com
